    {
      "id": "cj-146",
      "unit": "qihuan_hy",
      "note": "名詞作動詞，讀作「旺」；「故王之不王」的第二個「王」同此用法。"
    },
    {
      "id": "cj-147",
      "unit": "qihuan_hy",
      "note": "名詞作動詞，讀作「意」，指穿上。"
    },
    {
      "id": "cj-148",
      "unit": "qihuan_hy",
      "note": "名詞作動詞，用秤稱量輕重。"
    },
    {
      "id": "cs-001",
      "unit": "xianqin",
      "note": "《詩經》存詩三百零五首，原稱《詩》或《詩三百》，西漢始尊為經。"
    },
    {
      "id": "cs-002",
      "unit": "xianqin",
      "note": "西漢劉向編屈原、宋玉及漢人擬作為《楚辭》，是《詩經》之後的詩歌總集。"
    },
    {
      "id": "cs-003",
      "unit": "xianqin",
      "note": "屈原名平字原，是第一位愛國主義詩人，也是第一位浪漫主義詩人。"
    },
    {
      "id": "cs-004",
      "unit": "xianqin",
      "note": "相傳孔子據魯國史修訂此書，文字簡短而寓褒貶，稱為春秋筆法。"
    },
    {
      "id": "cs-005",
      "unit": "xianqin",
      "note": "又稱《左氏春秋》，相傳為左丘明所作，是為《春秋》作傳之書。"
    },
    {
      "id": "cs-006",
      "unit": "xianqin",
      "note": "相傳為左丘明所著，分記八國史事，故有《春秋外傳》之稱。"
    },
    {
      "id": "cs-007",
      "unit": "xianqin",
      "note": "先秦除諸子散文外還有兵家著作，《孫子兵法》即其中最著名者。"
    },
    {
      "id": "cs-008",
      "unit": "xianqin",
      "note": "先秦典籍中此書專釋詞義，故被視為詞典之祖。"
    },
    {
      "id": "cs-009",
      "unit": "xianqin",
      "note": "此書記錄孔子及其弟子言行，共二十篇，後列為四書之一。"
    },
    {
      "id": "cs-010",
      "unit": "xianqin",
      "note": "秦相呂不韋集門客編成，分十二紀、八覽、六論，共一百六十篇。"
    },
    {
      "id": "cs-011",
      "unit": "zhuzi",
      "note": "此寓言出自《孟子》，孟子名軻，被尊為「亞聖」。"
    },
    {
      "id": "cs-012",
      "unit": "zhuzi",
      "note": "同出《孟子》，與揠苗助長同為孟子書中著名的寓言。"
    },
    {
      "id": "cs-013",
      "unit": "zhuzi",
      "note": "《莊子》又稱《南華經》，共三十三篇，多寓言。"
    },
    {
      "id": "cs-014",
      "unit": "zhuzi",
      "note": "莊子名周，戰國時期的道家代表，與老子同屬道家。"
    },
    {
      "id": "cs-015",
      "unit": "zhuzi",
      "note": "《莊子》寓言極多，另有匠石運斤、東施效顰亦出此書。"
    },
    {
      "id": "cs-016",
      "unit": "zhuzi",
      "note": "此寓言與井底之蛙、庖丁解牛同見於《莊子》。"
    },
    {
      "id": "cs-017",
      "unit": "zhuzi",
      "note": "列子名禦寇，戰國道家，《列子》保存大量寓言神話。"
    },
    {
      "id": "cs-018",
      "unit": "zhuzi",
      "note": "此寓言與兩小兒辯日、杞人憂天同出《列子》。"
    },
    {
      "id": "cs-019",
      "unit": "zhuzi",
      "note": "《列子》多採神話寓言，另有紀昌學射一篇。"
    },
    {
      "id": "cs-020",
      "unit": "zhuzi",
      "note": "《戰國策》由西漢劉向編訂，記載戰國游說之士的策謀言論。"
    },
    {
      "id": "cs-021",
      "unit": "zhuzi",
      "note": "此書又稱《國策》，屬國別體史書，以記言為主。"
    },
    {
      "id": "cs-022",
      "unit": "zhuzi",
      "note": "戰國策士善用譬喻，故書中寓言多與游說相關。"
    },
    {
      "id": "cs-023",
      "unit": "zhuzi",
      "note": "與畫蛇添足、狐假虎威、狡兔三窟同出《戰國策》。"
    },
    {
      "id": "cs-024",
      "unit": "zhuzi",
      "note": "《呂氏春秋》又稱《呂覽》，是雜家的代表著作。"
    },
    {
      "id": "cs-025",
      "unit": "zhuzi",
      "note": "此書由呂不韋集合門客編寫，內容以儒家思想為主。"
    },
    {
      "id": "cs-026",
      "unit": "zhuzi",
      "note": "與刻舟求劍、引嬰投江同出《呂氏春秋》，皆為寓言。"
    },
    {
      "id": "cs-027",
      "unit": "xianqin2",
      "note": "原稱《詩》或《詩三百》，西漢被尊為經典後才稱《詩經》。"
    },
    {
      "id": "cs-028",
      "unit": "xianqin2",
      "note": "三者之中《關雎》屬國風，是《詩經》全書第一篇。"
    },
    {
      "id": "cs-029",
      "unit": "xianqin2",
      "note": "賦、比、興與風、雅、頌合稱「詩經六義」。"
    },
    {
      "id": "cs-030",
      "unit": "xianqin2",
      "note": "內容分風雅頌，手法分賦比興，兩者合稱「詩經六義」。"
    },
    {
      "id": "cs-031",
      "unit": "xianqin2",
      "note": "五經是儒家經典，後人另把《論語》《大學》《中庸》《孟子》合稱「四書」。"
    },
    {
      "id": "cs-032",
      "unit": "xianqin2",
      "note": "它是全書首篇，屬《國風·周南》的一首情詩。"
    },
    {
      "id": "cs-033",
      "unit": "xianqin2",
      "note": "又稱「騷體」，打破《詩經》四言格式，多融神話傳說。"
    },
    {
      "id": "cs-034",
      "unit": "xianqin2",
      "note": "他編成《楚辭》，是繼《詩經》之後又一部詩歌總集。"
    },
    {
      "id": "cs-035",
      "unit": "xianqin2",
      "note": "宋玉相傳為屈原弟子，代表作有《九辯》《風賦》。"
    },
    {
      "id": "cs-036",
      "unit": "xianqin2",
      "note": "字仲尼，春秋末期魯國人，儒家學派創始人。"
    },
    {
      "id": "cs-037",
      "unit": "xianqin2",
      "note": "名丘，被後世尊為「聖人」與「萬世師表」。"
    },
    {
      "id": "cs-038",
      "unit": "xianqin2",
      "note": "他主張「有教無類」，相傳弟子多達三千人。"
    },
    {
      "id": "cs-039",
      "unit": "xianqin2",
      "note": "他是儒家創始人，教育上主張「有教無類」「因材施教」。"
    },
    {
      "id": "cs-040",
      "unit": "xianqin2",
      "note": "《論語》共二十篇，記錄孔子與這批弟子的言行。"
    },
    {
      "id": "cs-041",
      "unit": "xianqin2",
      "note": "它是語錄體著作，記錄孔子及其弟子的言行。"
    },
    {
      "id": "cs-042",
      "unit": "xianqin2",
      "note": "四書與五經並列，同為後世儒家的重要經典。"
    },
    {
      "id": "cs-043",
      "unit": "xianqin2",
      "note": "孔門四科為德行、言語、政事、文學。"
    },
    {
      "id": "cs-044",
      "unit": "xianqin2",
      "note": "孟子名軻，戰國時期人，主張行仁政與性善論。"
    },
    {
      "id": "cs-045",
      "unit": "xianqin2",
      "note": "孟子被尊為「亞聖」，主張君主實行仁政。"
    },
    {
      "id": "cs-046",
      "unit": "xianqin2",
      "note": "荀子名況，戰國末期趙國人，韓非與李斯都是他的學生。"
    },
    {
      "id": "cs-047",
      "unit": "xianqin2",
      "note": "荀子名況，主張性惡論，是戰國末期的趙國人。"
    },
    {
      "id": "cs-048",
      "unit": "xianqin2",
      "note": "老子姓李名耳，春秋末期楚國人，道家學派創始人。"
    },
    {
      "id": "cs-049",
      "unit": "xianqin2",
      "note": "《道德經》又稱《老子五千文》，文字簡潔善用譬喻。"
    },
    {
      "id": "cs-050",
      "unit": "xianqin2",
      "note": "莊子是戰國時期道家代表，寓言有庖丁解牛、井底之蛙。"
    },
    {
      "id": "cs-051",
      "unit": "xianqin2",
      "note": "《莊子》共三十三篇，寓言有鯤鵬展翅、匠石運斤。"
    },
    {
      "id": "cs-052",
      "unit": "xianqin2",
      "note": "墨子名翟，主張「兼愛」「非攻」「尚賢」「節用」。"
    },
    {
      "id": "cs-053",
      "unit": "xianqin2",
      "note": "韓非是戰國末期韓國人，主張君主集權。"
    },
    {
      "id": "cs-054",
      "unit": "xianqin2",
      "note": "列子是戰國道家，《列子》保存大量寓言神話。"
    },
    {
      "id": "cs-055",
      "unit": "xianqin2",
      "note": "他是戰國末期秦相，《呂氏春秋》屬雜家，以儒家思想為主。"
    },
    {
      "id": "cs-056",
      "unit": "xianqin2",
      "note": "全書共二十六卷，又稱《呂覽》，分十二紀、八覽、六論。"
    },
    {
      "id": "cs-057",
      "unit": "xianqin2",
      "note": "此書又稱《南華經》，共三十三篇，多寓言。"
    },
    {
      "id": "cs-058",
      "unit": "xianqin2",
      "note": "此書為戰國道家著作，另存愚公移山、杞人憂天等寓言。"
    },
    {
      "id": "cs-059",
      "unit": "xianqin2",
      "note": "《左傳》是為《春秋》作傳的書，記事詳明。"
    },
    {
      "id": "cs-060",
      "unit": "xianqin2",
      "note": "三傳同為解說《春秋》之作，其中《左傳》敘事最詳。"
    },
    {
      "id": "cs-061",
      "unit": "xianqin2",
      "note": "《春秋》是我國第一部編年體史書，文字簡短而寓褒貶。"
    },
    {
      "id": "cs-062",
      "unit": "xianqin2",
      "note": "因存詩三百零五首而得名，西漢尊為經典後才稱《詩經》。"
    },
    {
      "id": "cs-063",
      "unit": "xianqin2",
      "note": "常用重章疊句，是我國現實主義詩歌的源頭。"
    },
    {
      "id": "cs-064",
      "unit": "xianqin2",
      "note": "《詩經》主現實主義，屈原是我國文學史上第一位浪漫主義詩人。"
    },
    {
      "id": "cs-065",
      "unit": "xianqin2",
      "note": "他名平字原，是戰國末期的楚國人，代表作《離騷》。"
    },
    {
      "id": "cs-066",
      "unit": "xianqin2",
      "note": "屈原名平，開創楚辭體，代表作《離騷》為古代最長抒情詩。"
    },
    {
      "id": "cs-067",
      "unit": "xianqin2",
      "note": "屈原以此體寫成《離騷》，打破《詩經》的四言格式。"
    },
    {
      "id": "cs-068",
      "unit": "xianqin2",
      "note": "《國殤》屬《九歌》，是追悼楚國將士亡靈的祭歌。"
    },
    {
      "id": "cs-069",
      "unit": "xianqin2",
      "note": "與屈原並稱「屈宋」，相傳為屈原弟子，代表作《九辯》。"
    },
    {
      "id": "cs-070",
      "unit": "xianqin2",
      "note": "宋玉是戰國末期楚國辭賦家，與屈原並稱「屈宋」。"
    },
    {
      "id": "cs-071",
      "unit": "xianqin2",
      "note": "《春秋》是我國第一部編年體史書，寓有褒貶。"
    },
    {
      "id": "cs-072",
      "unit": "xianqin2",
      "note": "它是我國第一部敘事詳備的編年體史書，相傳為左丘明所作。"
    },
    {
      "id": "cs-073",
      "unit": "xianqin2",
      "note": "《國語》是我國第一部國別體史書，分記八國史事。"
    },
    {
      "id": "cs-074",
      "unit": "xianqin2",
      "note": "此書分記八國史事，包括周、魯、齊、晉、鄭、楚、吳、越。"
    },
    {
      "id": "cs-075",
      "unit": "xianqin2",
      "note": "西漢劉向編訂，記載戰國游說之士的策謀言論。"
    },
    {
      "id": "cs-076",
      "unit": "xianqin2",
      "note": "此書又稱《國策》，寓言有畫蛇添足、狐假虎威、狡兔三窟。"
    },
    {
      "id": "cs-077",
      "unit": "xianqin2",
      "note": "孔子名丘字仲尼，春秋末期魯國人，被尊為「萬世師表」。"
    },
    {
      "id": "cs-078",
      "unit": "xianqin2",
      "note": "這主張與「因材施教」並列，是孔子著名的教育思想。"
    },
    {
      "id": "cs-079",
      "unit": "xianqin2",
      "note": "其中優秀者七十二人，孔門四科為德行、言語、政事、文學。"
    },
    {
      "id": "cs-080",
      "unit": "xianqin2",
      "note": "四科之外，孔子最得意的弟子是顏淵。"
    },
    {
      "id": "cs-081",
      "unit": "xianqin2",
      "note": "孟子字子輿，被尊為「亞聖」，主張性善論與仁政。"
    },
    {
      "id": "cs-082",
      "unit": "xianqin2",
      "note": "孟子寓言有揠苗助長、齊人有一妻一妾。"
    },
    {
      "id": "cs-083",
      "unit": "xianqin2",
      "note": "荀子主張性惡論，韓非與李斯都是他的學生。"
    },
    {
      "id": "cs-084",
      "unit": "xianqin2",
      "note": "老子是道家創始人，主張「無為而治」。"
    },
    {
      "id": "cs-085",
      "unit": "xianqin2",
      "note": "《道德經》共八十一章，文字簡潔，善用譬喻。"
    },
    {
      "id": "cs-086",
      "unit": "xianqin2",
      "note": "此書又稱《南華經》，是莊周的著作。"
    },
    {
      "id": "cs-087",
      "unit": "xianqin2",
      "note": "墨子主張「兼愛」「非攻」，又提倡「尚賢」「節用」。"
    },
    {
      "id": "cs-088",
      "unit": "xianqin2",
      "note": "墨家與儒家並稱「顯學」，墨子另主張兼愛與尚賢。"
    },
    {
      "id": "cs-089",
      "unit": "xianqin2",
      "note": "韓非是先秦法家學說的集大成者，主張君主集權。"
    },
    {
      "id": "cs-090",
      "unit": "xianqin2",
      "note": "韓非是戰國末期的韓國人，為法家集大成者。"
    },
    {
      "id": "cs-091",
      "unit": "xianqin2",
      "note": "此書由秦相呂不韋集合門客編寫，屬雜家代表。"
    },
    {
      "id": "cs-092",
      "unit": "xianqin2",
      "note": "又稱《呂覽》，分十二紀、八覽、六論，共一百六十篇。"
    },
    {
      "id": "cs-093",
      "unit": "xianqin2",
      "note": "屈原名平字原，開創楚辭體，是我國第一位愛國主義詩人。"
    },
    {
      "id": "cs-094",
      "unit": "xianqin2",
      "note": "荀子名況，主張性惡論，韓非與李斯都是他的學生。"
    },
    {
      "id": "cs-095",
      "unit": "keju",
      "note": "漢代由地方推薦人才給中央，被薦者經皇帝策問後授官。"
    },
    {
      "id": "cs-096",
      "unit": "keju",
      "note": "孝廉與茂才並列，同為漢代察舉制的主要科目。"
    },
    {
      "id": "cs-097",
      "unit": "keju",
      "note": "東漢為避光武帝劉秀的名諱，才把秀才改稱茂才。"
    },
    {
      "id": "cs-098",
      "unit": "keju",
      "note": "他名劉秀，故「秀才」因避諱而改稱「茂才」。"
    },
    {
      "id": "cs-099",
      "unit": "keju",
      "note": "射策是抽籤取題作答，另一種正面作答的方式稱對策。"
    },
    {
      "id": "cs-100",
      "unit": "keju",
      "note": "此制後被豪門操縱，出現「上品無寒門」的局面。"
    },
    {
      "id": "cs-101",
      "unit": "keju",
      "note": "豪門操縱之下，形成「上品無寒門」「下品無勢族」的局面。"
    },
    {
      "id": "cs-102",
      "unit": "keju",
      "note": "這兩句反映九品中正制後期只重門第，寒門難以上進。"
    },
    {
      "id": "cs-103",
      "unit": "keju",
      "note": "隋代廢九品中正制，設進士與明經二科，科舉由此正式誕生。"
    },
    {
      "id": "cs-104",
      "unit": "keju",
      "note": "隋代以進士、明經二科取士，標誌科舉制度的正式開始。"
    },
    {
      "id": "cs-105",
      "unit": "keju",
      "note": "唐代承隋制，以進士與明經二科最重要，另有皇帝特詔的制舉。"
    },
    {
      "id": "cs-106",
      "unit": "keju",
      "note": "唐代另有地方舉送中央考試的鄉貢，兩者並行。"
    },
    {
      "id": "cs-107",
      "unit": "keju",
      "note": "王安石廢明經等科，只保留進士科，是宋代科舉的一大改革。"
    },
    {
      "id": "cs-108",
      "unit": "keju",
      "note": "宋代禮部考試合格後由皇帝覆審，分五甲發榜授官。"
    },
    {
      "id": "cs-109",
      "unit": "keju",
      "note": "童試屬入學資格，考中後才成為生員，是功名的起點。"
    },
    {
      "id": "cs-110",
      "unit": "keju",
      "note": "童試的應考者稱童生，通過後才稱生員。"
    },
    {
      "id": "cs-111",
      "unit": "keju",
      "note": "生員又稱庠生，俗稱秀才，是功名的起點。"
    },
    {
      "id": "cs-112",
      "unit": "keju",
      "note": "鄉試在省城舉行，三年一次，又稱大比。"
    },
    {
      "id": "cs-113",
      "unit": "keju",
      "note": "鄉試於秋季在省城舉行，故又稱秋闈，考中者稱舉人。"
    },
    {
      "id": "cs-114",
      "unit": "keju",
      "note": "鄉試第一名稱解元，會試第一名則稱會元。"
    },
    {
      "id": "cs-115",
      "unit": "keju",
      "note": "鄉試在省城舉行，三年一次，又稱秋闈、大比。"
    },
    {
      "id": "cs-116",
      "unit": "keju",
      "note": "會試於鄉試次年春天在禮部舉行，故稱春闈或禮闈。"
    },
    {
      "id": "cs-117",
      "unit": "keju",
      "note": "會試由禮部主持，考中者稱貢士，第一名稱會元。"
    },
    {
      "id": "cs-118",
      "unit": "keju",
      "note": "會試第一名稱會元，貢士經殿試後統稱進士。"
    },
    {
      "id": "cs-119",
      "unit": "keju",
      "note": "會試春天在禮部舉行，考中者稱貢士，第一名才是會元。"
    },
    {
      "id": "cs-120",
      "unit": "keju",
      "note": "狀元授翰林院修撰，與榜眼、探花合稱「三鼎甲」。"
    },
    {
      "id": "cs-121",
      "unit": "keju",
      "note": "榜眼與探花同授翰林院編修，狀元則授修撰。"
    },
    {
      "id": "cs-122",
      "unit": "keju",
      "note": "第二甲賜進士出身，其第一名俗稱傳臚。"
    },
    {
      "id": "cs-123",
      "unit": "keju",
      "note": "三鼎甲即殿試第一甲，依次為狀元、榜眼、探花。"
    },
    {
      "id": "cs-124",
      "unit": "keju",
      "note": "殿試第一甲三名依次為狀元、榜眼、探花，皆授翰林官。"
    },
    {
      "id": "cs-125",
      "unit": "keju",
      "note": "修撰授狀元，編修授榜眼與探花，是明清授職慣例。"
    },
    {
      "id": "cs-126",
      "unit": "keju",
      "note": "明清正式考試分鄉試、會試、殿試三級，均考八股文。"
    },
    {
      "id": "cs-127",
      "unit": "keju",
      "note": "連中三元又稱三元及第，是科舉制度中的最高榮譽。"
    },
    {
      "id": "cs-128",
      "unit": "keju",
      "note": "武舉自武則天時期開始，後代沿襲至清代仍有武科。"
    },
    {
      "id": "cs-129",
      "unit": "keju",
      "note": "唐代承隋制，進士與明經二科最重要，另有制舉與鄉貢。"
    },
    {
      "id": "cs-130",
      "unit": "keju",
      "note": "宋代禮部考試合格後由皇帝殿試覆審，再分五甲發榜。"
    },
    {
      "id": "cs-131",
      "unit": "keju",
      "note": "殿試由皇帝主考，貢士考中後統稱進士。"
    },
    {
      "id": "cs-132",
      "unit": "keju",
      "note": "貢士經殿試考策問後統稱進士，再按三甲授職。"
    },
    {
      "id": "cs-133",
      "unit": "keju",
      "note": "第一甲三名依次為狀元、榜眼、探花，合稱「三鼎甲」。"
    },
    {
      "id": "cs-134",
      "unit": "keju",
      "note": "第二甲第一名俗稱傳臚，第三甲則賜同進士出身。"
    },
    {
      "id": "cs-135",
      "unit": "keju",
      "note": "殿試三甲各有名銜，依次為進士及第、進士出身、同進士出身。"
    },
    {
      "id": "cs-136",
      "unit": "keju",
      "note": "會試在鄉試次年春天於禮部舉行，故稱春闈或禮闈。"
    },
    {
      "id": "cs-137",
      "unit": "keju",
      "note": "鄉試三年一次，因在秋季舉行，故又稱秋闈。"
    },
    {
      "id": "cs-138",
      "unit": "keju",
      "note": "鄉試在省城舉行，考中者稱舉人，第一名稱解元。"
    },
    {
      "id": "cs-139",
      "unit": "keju",
      "note": "對策是針對策問正面作答，射策則是抽籤取題。"
    },
    {
      "id": "cs-140",
      "unit": "keju",
      "note": "明清科舉最完備，正式考試分鄉試、會試、殿試三級。"
    },
    {
      "id": "cs-141",
      "unit": "keju",
      "note": "鄉試解元、會試會元、殿試狀元，三者合稱連中三元。"
    },
    {
      "id": "cs-142",
      "unit": "keju",
      "note": "宋代王安石改革只留進士科，殿試分五甲發榜授官。"
    },
    {
      "id": "cs-143",
      "unit": "keju",
      "note": "唐代承隋制，以進士、明經二科最重要，另有制舉。"
    },
    {
      "id": "cs-144",
      "unit": "hanwei",
      "note": "全詩敘寫焦仲卿與劉蘭芝的婚姻悲劇，是漢樂府民歌的代表作。"
    },
    {
      "id": "cs-145",
      "unit": "hanwei",
      "note": "《玉台新詠》為南朝陳徐陵所編，是繼《詩經》《楚辭》之後的詩歌總集。"
    },
    {
      "id": "cs-146",
      "unit": "hanwei",
      "note": "《樂府詩集》收錄漢至唐的樂府詩，由宋代的郭茂倩編成。"
    },
    {
      "id": "cs-147",
      "unit": "hanwei",
      "note": "徐陵在南朝陳時編成此書，使《孔雀東南飛》得以流傳後世。"
    },
    {
      "id": "cs-148",
      "unit": "hanwei",
      "note": "焦仲卿與劉蘭芝的悲劇，反映封建家長制度對婚姻的壓迫。"
    },
    {
      "id": "cs-149",
      "unit": "hanwei",
      "note": "劉蘭芝與焦仲卿雙雙殉情，二人故事即《孔雀東南飛》全詩主線。"
    },
    {
      "id": "cs-150",
      "unit": "hanwei",
      "note": "《木蘭辭》屬北朝樂府民歌，與《孔雀東南飛》一南一北相互輝映。"
    },
    {
      "id": "cs-151",
      "unit": "hanwei",
      "note": "易混：《孔雀東南飛》與《木蘭辭》稱樂府雙璧，與《陌上桑》稱漢樂府雙璧。"
    },
    {
      "id": "cs-152",
      "unit": "hanwei",
      "note": "漢武帝設樂府採集民歌並配樂譜，這些歌辭後來也稱「樂府」。"
    },
    {
      "id": "cs-153",
      "unit": "hanwei",
      "note": "曹操是東漢末年政治家、軍事家，其詩多寫亂世與壯志。"
    },
    {
      "id": "cs-154",
      "unit": "hanwei",
      "note": "此詩作者為曹操次子曹丕，他另撰有《典論·論文》。"
    },
    {
      "id": "cs-155",
      "unit": "hanwei",
      "note": "曹丕與父曹操、弟曹植合稱「三曹」，是建安文學的代表。"
    },
    {
      "id": "cs-156",
      "unit": "hanwei",
      "note": "此篇為曹丕所作，與其《燕歌行》同屬建安文學的重要成果。"
    },
    {
      "id": "cs-157",
      "unit": "hanwei",
      "note": "曹植字子建，封陳王、諡「思」，故世稱陳思王。"
    },
    {
      "id": "cs-158",
      "unit": "hanwei",
      "note": "「陳」是封國，「思」是諡號，合起來即其封號與諡號。"
    },
    {
      "id": "cs-159",
      "unit": "hanwei",
      "note": "謝靈運評「天下才有一石，曹子建獨占八斗」，可見推重之甚。"
    },
    {
      "id": "cs-160",
      "unit": "hanwei",
      "note": "三人為父子，同是建安文學的代表人物，後人合稱「三曹」。"
    },
    {
      "id": "cs-161",
      "unit": "hanwei",
      "note": "《文選》由南朝梁蕭統編成，是《古詩十九首》最早的著錄出處。"
    },
    {
      "id": "cs-162",
      "unit": "hanwei",
      "note": "這些作品作者不詳，卻標誌著文人五言詩的成熟。"
    },
    {
      "id": "cs-163",
      "unit": "hanwei",
      "note": "劉勰譽為「五言之冠冕」，鍾嶸讚其「一字千金」，評價極高。"
    },
    {
      "id": "cs-164",
      "unit": "hanwei",
      "note": "劉勰在《文心雕龍》中以此譽《古詩十九首》，肯定其五言成就。"
    },
    {
      "id": "cs-165",
      "unit": "hanwei",
      "note": "此語出自鍾嶸《詩品》，與劉勰「五言之冠冕」同為名評。"
    },
    {
      "id": "cs-166",
      "unit": "hanwei",
      "note": "陶淵明名潛，字元亮，是文學史上第一位田園詩人。"
    },
    {
      "id": "cs-167",
      "unit": "hanwei",
      "note": "他私諡「靖節」，世稱靖節先生，又稱五柳先生。"
    },
    {
      "id": "cs-168",
      "unit": "hanwei",
      "note": "「靖節」是私諡而非官諡，故後人以靖節先生相稱。"
    },
    {
      "id": "cs-169",
      "unit": "hanwei",
      "note": "他曾任彭澤令，後人常以任職之地相稱，如謝康樂、謝臨川。"
    },
    {
      "id": "cs-170",
      "unit": "hanwei",
      "note": "他歸隱後多寫田園生活，《歸園田居》《飲酒》皆為代表作。"
    },
    {
      "id": "cs-171",
      "unit": "hanwei",
      "note": "此篇寫棄官歸田之志，是陶淵明辭賦的代表作。"
    },
    {
      "id": "cs-172",
      "unit": "hanwei",
      "note": "古人常以封爵或任職之地稱人，故有謝康樂、謝臨川等別稱。"
    },
    {
      "id": "cs-173",
      "unit": "hanwei",
      "note": "他被視為山水詩派鼻祖，使山水成為詩歌的主要題材。"
    },
    {
      "id": "cs-174",
      "unit": "hanwei",
      "note": "《山居賦》寫其隱居山中的生活，是謝靈運辭賦代表作。"
    },
    {
      "id": "cs-175",
      "unit": "hanwei",
      "note": "二人皆長於山水詩，謝靈運稱大謝，謝朓稱小謝。"
    },
    {
      "id": "cs-176",
      "unit": "hanwei",
      "note": "「小謝」與「大謝」相對，指時代較晚的謝朓。"
    },
    {
      "id": "cs-177",
      "unit": "hanwei",
      "note": "曹丕是曹操次子，其弟曹植即封陳王的曹子建。"
    },
    {
      "id": "cs-178",
      "unit": "hanwei",
      "note": "曹植兼善詩賦，詩有《七哀詩》《白馬篇》，賦有《洛神賦》。"
    },
    {
      "id": "cs-179",
      "unit": "hanwei",
      "note": "除離愁別恨外也寫士人失意，反映東漢末年的時代情緒。"
    },
    {
      "id": "cs-180",
      "unit": "hanwei",
      "note": "如《行行重行行》《西北有高樓》《涉江采芙蓉》皆取首句為題。"
    },
    {
      "id": "cs-181",
      "unit": "hanwei",
      "note": "它與《文選》同為南朝所編，保存了漢魏以來的詩歌。"
    },
    {
      "id": "cs-182",
      "unit": "hanwei",
      "note": "樂府由官署名變為詩體名，後世仿作也稱樂府詩。"
    },
    {
      "id": "cs-183",
      "unit": "hanwei",
      "note": "此文以漁人誤入桃源的故事，寄託對理想社會的嚮往。"
    },
    {
      "id": "cs-184",
      "unit": "hanwei",
      "note": "《歸園田居》為組詩，寫歸隱後的田園勞作與心境。"
    },
    {
      "id": "cs-185",
      "unit": "hanwei",
      "note": "曹操代表作有《觀滄海》《短歌行》《蒿里行》《龜雖壽》。"
    },
    {
      "id": "cs-186",
      "unit": "hanwei",
      "note": "作者曹丕是曹操次子，與父、弟並稱「三曹」。"
    },
    {
      "id": "cs-187",
      "unit": "wenhua",
      "note": "日、月加五星合為七，古人以此觀察天象的運行。"
    },
    {
      "id": "cs-188",
      "unit": "wenhua",
      "note": "金星黎明見東方稱啟明，黃昏見西方稱長庚，皆指同一星。"
    },
    {
      "id": "cs-189",
      "unit": "wenhua",
      "note": "同一顆金星，黎明在東稱啟明，黃昏在西稱長庚。"
    },
    {
      "id": "cs-190",
      "unit": "wenhua",
      "note": "木星古稱歲星，因其運行可用以紀年，故與曆法相關。"
    },
    {
      "id": "cs-191",
      "unit": "wenhua",
      "note": "五星古名各異，水為辰星、火為熒惑、土為鎮星，容易混淆。"
    },
    {
      "id": "cs-192",
      "unit": "wenhua",
      "note": "火星古稱熒惑，與水星辰星、木星歲星並列五星別稱。"
    },
    {
      "id": "cs-193",
      "unit": "wenhua",
      "note": "土星古稱鎮星，與歲星、辰星、太白、熒惑合為五星。"
    },
    {
      "id": "cs-194",
      "unit": "wenhua",
      "note": "二十八宿分布於黃道、赤道附近，是古人觀測天象的坐標。"
    },
    {
      "id": "cs-195",
      "unit": "wenhua",
      "note": "四象與四方相配：東蒼龍、西白虎、南朱雀、北玄武。"
    },
    {
      "id": "cs-196",
      "unit": "wenhua",
      "note": "玄武為龜蛇合體之象，故北方七宿以此為名。"
    },
    {
      "id": "cs-197",
      "unit": "wenhua",
      "note": "西方七宿為奎婁胃昴畢觜參，合稱白虎。"
    },
    {
      "id": "cs-198",
      "unit": "wenhua",
      "note": "南方七宿自井宿起至軫宿，合稱朱雀。"
    },
    {
      "id": "cs-199",
      "unit": "wenhua",
      "note": "蒼龍七宿依次為角、亢、氐、房、心、尾、箕。"
    },
    {
      "id": "cs-200",
      "unit": "wenhua",
      "note": "陰曆以月亮盈虧為單位，與以太陽年為單位的陽曆相對。"
    },
    {
      "id": "cs-201",
      "unit": "wenhua",
      "note": "我國古代曆法兼採陰陽，並以閏月調整，使平均長度合於太陽年。"
    },
    {
      "id": "cs-202",
      "unit": "wenhua",
      "note": "平年六大月各三十天、六小月各二十九天，合共三百五十四天。"
    },
    {
      "id": "cs-203",
      "unit": "wenhua",
      "note": "四季各分孟、仲、季，春季三月依次為孟春、仲春、季春。"
    },
    {
      "id": "cs-204",
      "unit": "wenhua",
      "note": "正月兩個節氣為立春、雨水，立春居二十四節氣之首。"
    },
    {
      "id": "cs-205",
      "unit": "wenhua",
      "note": "二月節氣依次為驚蟄、春分，與正月的立春、雨水相接。"
    },
    {
      "id": "cs-206",
      "unit": "wenhua",
      "note": "斗柄指東為春、指南為夏、指西為秋、指北為冬。"
    },
    {
      "id": "cs-207",
      "unit": "wenhua",
      "note": "十天干依次為甲乙丙丁戊己庚辛壬癸，甲居其首。"
    },
    {
      "id": "cs-208",
      "unit": "wenhua",
      "note": "天干十與地支十二依次相配，共得六十單位，周而復始。"
    },
    {
      "id": "cs-209",
      "unit": "wenhua",
      "note": "三正指夏正建寅、殷正建丑、周正建子，漢武帝後用夏正。"
    },
    {
      "id": "cs-210",
      "unit": "wenhua",
      "note": "殷正以建丑之月為歲首，與夏正、周正並稱三正。"
    },
    {
      "id": "cs-211",
      "unit": "wenhua",
      "note": "周正以建子之月為歲首，是三正中最前的一個月。"
    },
    {
      "id": "cs-212",
      "unit": "wenhua",
      "note": "古代元旦指正月初一，現代元旦則指陽曆一月一日。"
    },
    {
      "id": "cs-213",
      "unit": "wenhua",
      "note": "八月十五居秋季之中，故稱中秋，是賞月佳節。"
    },
    {
      "id": "cs-214",
      "unit": "wenhua",
      "note": "九為陽數，兩九相重故稱重陽，古人有登高飲酒之俗。"
    },
    {
      "id": "cs-215",
      "unit": "wenhua",
      "note": "「除」是除舊布新之意，故一年最後一夜稱除夕。"
    },
    {
      "id": "cs-216",
      "unit": "wenhua",
      "note": "五音依次為宮、商、角、徵、羽，是我國傳統的音階。"
    },
    {
      "id": "cs-217",
      "unit": "wenhua",
      "note": "十二律從低到高依次為黃鐘、大呂、太簇等，黃鐘居首。"
    },
    {
      "id": "cs-218",
      "unit": "wenhua",
      "note": "十二律分陰陽，奇數為陽律稱六律，偶數為陰律稱六呂。"
    },
    {
      "id": "cs-219",
      "unit": "wenhua",
      "note": "八音按製作材料分為金、石、土、革、絲、木、匏、竹八類。"
    },
    {
      "id": "cs-220",
      "unit": "wenhua",
      "note": "八音以材料分類，金類樂器有鐘、鎛等，屬打擊樂器。"
    },
    {
      "id": "cs-221",
      "unit": "wenhua",
      "note": "竹類樂器以竹製的管、簫為代表，與匏類的笙不同。"
    },
    {
      "id": "cs-222",
      "unit": "wenhua",
      "note": "金星晨見東方為啟明，昏見西方為長庚，實為同一顆星。"
    },
    {
      "id": "cs-223",
      "unit": "wenhua",
      "note": "分野把天上星宿與地上州國對應，是古代天文與地理的結合。"
    },
    {
      "id": "cs-224",
      "unit": "wenhua",
      "note": "四季以孟、仲、季為序，孟春即春季第一個月，也就是正月。"
    },
    {
      "id": "cs-225",
      "unit": "wenhua",
      "note": "仲夏為夏季第二個月，即農曆五月，其後為季夏。"
    },
    {
      "id": "cs-226",
      "unit": "wenhua",
      "note": "三月節氣為清明、穀雨，穀雨在清明之後。"
    },
    {
      "id": "cs-227",
      "unit": "wenhua",
      "note": "六月節氣為小暑、大暑，小暑在前，暑氣漸盛。"
    },
    {
      "id": "cs-228",
      "unit": "wenhua",
      "note": "十二律以黃鐘為首，其後依次為大呂、太簇、夾鐘等。"
    },
    {
      "id": "cs-229",
      "unit": "wenhua",
      "note": "奇數六律為陽律稱六律，偶數六律為陰律稱六呂。"
    },
    {
      "id": "cs-230",
      "unit": "wenhua",
      "note": "石器以磬為代表，是古代重要的打擊樂器。"
    },
    {
      "id": "cs-231",
      "unit": "wenhua",
      "note": "八音以材料分，土類以塤為代表，與石類的磬有別。"
    },
    {
      "id": "cs-232",
      "unit": "wenhua",
      "note": "絲類指弦樂器，以琴、瑟為代表。"
    },
    {
      "id": "cs-233",
      "unit": "wenhua",
      "note": "匏類以笙為代表，與竹類的管簫同為吹奏樂器。"
    },
    {
      "id": "cs-234",
      "unit": "wenhua",
      "note": "正月年節有元旦與人日，人日即正月初七日。"
    },
    {
      "id": "cs-235",
      "unit": "wenhua",
      "note": "冬至是節氣起點，古有「冬至一陽生」之說，前一日稱小至。"
    },
    {
      "id": "cs-236",
      "unit": "wenhua",
      "note": "臘日為十二月初八，今有吃臘八粥的風俗。"
    },
    {
      "id": "cs-237",
      "unit": "wenhua",
      "note": "十二地支依次為子、丑、寅、卯、辰、巳、午、未、申、酉、戌、亥。"
    },
    {
      "id": "cs-238",
      "unit": "wenhua",
      "note": "以月相盈虧為週期的月稱朔望月，是陰曆的基礎。"
    },
    {
      "id": "cs-239",
      "unit": "wenhua",
      "note": "漢武帝頒行太初曆，此後歷代採用夏正，以建寅之月為歲首。"
    },
    {
      "id": "cs-240",
      "unit": "wenhua",
      "note": "五音加變宮、變徵即為七音，音階較五音更完備。"
    },
    {
      "id": "cs-241",
      "unit": "wenhua",
      "note": "南方朱雀七宿依次為井、鬼、柳、星、張、翼、軫。"
    },
    {
